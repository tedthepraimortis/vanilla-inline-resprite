//Tips
TIP_TIP = "\crTIP: \cu";
TIP_1 = "Read the manual!\n(open the pk7 with 7Zip and look for \cdhd_manual.md\cu)";
TIP_2 = "Hold \cdUse\cu to check what options are available for a given weapon.";
TIP_3 = "Make sure you bind keys for \cdall weapon \'User\' buttons\cu\n\cdDrop Weapon\cu, \cdZoom\cu and \cdReload\cu!";
TIP_4 = "Check the menu for additional keybinds unique to HD!";
TIP_5 = "To stop bleeding, hit \cd9\cu or use the \cdmedikit\cu.\nThen, if needed, take off your armour\nby hitting \cdReload\cu.";
TIP_6 = "Hold \cdJump\cu and move forwards into a ledge to try to clamber over it.";
TIP_7 = "Hit \cdUser3\cu to access the magazine manager on most weapons.";
TIP_8 = "Hit \cdUser4\cu to unload most weapons.";
TIP_9 = "If you are carrying too much useless ammo,\nhit the \cdPurge Useless Ammo\cu key\nor use the \cdhd_purge\cu command.";
TIP_10 = "\cvTr\caan\cjs ri\cagh\cvts\cu are human rights, the same way guns are weapons.\nIf you're having trouble with this, one stopgap measure\nis to think of this in the same way guns are loaded.";
TIP_11 = "Hit \cdUse\cu on a ladder to start climbing, and again or \cdJump\cu to dismount.\nHit \cdJump\cu while \cdcrouching\cu to take down the ladder.";
TIP_12 = "Your movement and turning affect your punches and grenades.\nGo to the range and practice!";
TIP_13 = "Use stimpacks to slow down bleeding.";
TIP_14 = "If the sight picture is getting in your way when you're on the move,\ntry changing the \cdhd_noscope\cu and \cdhd_sightbob\cu settings to taste.";
TIP_15 = "Holding \cdZoom\cu will greatly stabilize your aim,\nand implicitly brace your weapon\nagainst nearby map geometry.";
TIP_16 = "Hold \cdZoom\cu when firing an airburst rocket or grenade\nto prevent the airburst value from resetting.";
TIP_17 = "Hit the \cdDrop One\cu key or use the \cdhd_dropone\cu command\nto drop a single unit of each ammo type used by your current weapon.";
TIP_18 = "If you don't want the diving action when you hit \cdCrouch\cu while running,\nset \cdhd_noslide\cu to 1 or use the menu.";
TIP_19 = "If you don't want \cdZoom\cu to make you lean,\nset \cdhd_nozoomlean\cu to true.";
TIP_20 = "Set \cdfraglimit\cu to 100+ to enable HD's elimination mode.\nIn co-op, a positive fraglimit under 100\nalso serves as a lives limit.";
TIP_21 = "Turn on \cdhd_pof\cu in co-op or teamplay for a one-life mode where\nyou can only be raised in the presence of all living teammates.";
TIP_22 = "Turn on \cdhd_flagpole\cu in multiplayer to create an objective!\n(Move AWAY from the flagpole to program the flag.)";
TIP_23 = "Turn on \cdhd_nobots\cu to cause the bots to be replaced by HD riflemen.";
TIP_24 = "To remote activate a switch or door,\ntype \cdderp 555\cu to stick a D.E.R.P. on to it,\nthen \cdderp 556\cu to make it flick the switch.";
TIP_25 = "Hold \cdZoom\cu and/or \cdUse\cu when you use the goggles to set the amplitude.\nBoth together decrements, \cdUse\cu alone increments.\n\cdZoom\cu alone toggles red/green mode.";
TIP_26 = "Zombies never surrender!\nIf a downed monster is still twitching,\nthey may be able to recover and attack again.";
TIP_27 = "If a map contains a mandatory drop that is harmless\nin vanilla but absolutely cannot be survived in HD,\nit is socially acceptable to cheat past it with \cdiddqd\cu or \cdfly\cu.";
TIP_29 = "Drink DRLA water. This is a threat.";
TIP_30 = "Your ZM-66 jamming too much?\nTry using it on semi auto or burst fire!\nLess rounds fired and missed means less chance of jams!";

